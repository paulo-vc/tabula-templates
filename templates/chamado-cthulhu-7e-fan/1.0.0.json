    {
      "id": "corpo",
      "key": "corpo",
      "label": "Corpo",
      "description": "FOR+TAM: 2–64 → −2 (BD −2); 65–84 → −1 (BD −1); 85–124 → 0; 125–164 → +1 (BD +1d4); 165–204 → +2 (BD +1d6).",
      "type": "computed",
      "formula": "if(@for + @tam >= 165, 2, if(@for + @tam >= 125, 1, if(@for + @tam >= 85, 0, if(@for + @tam >= 65, -1, -2))))",
      "signed": true
    },
    {
      "id": "bonus_dano",
      "key": "bonus_dano",
      "label": "Bônus de dano",
      "description": "Veja a tabela em Corpo (ex.: +1d4).",
      "type": "dice"
    },
    {
      "id": "movimento",
      "key": "movimento",
      "label": "Movimento",
      "type": "computed",
      "formula": "if(max(@des, @for) < @tam, 7, if(min(@des, @for) > @tam, 9, 8)) - if(@idade >= 80, 5, if(@idade >= 70, 4, if(@idade >= 60, 3, if(@idade >= 50, 2, if(@idade >= 40, 1, 0)))))"
    },
